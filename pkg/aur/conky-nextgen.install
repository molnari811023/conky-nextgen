post_install() {
  cat << 'EOF'

:: ============================================================================
:: Conky NextGen — Modular Widget Framework & Desktop Monitor
:: ============================================================================
:: OPTIONAL TELEMETRY BACKENDS & DEPENDENCY CONFLICT NOTICE:
::
:: 1. Apple iCloud / iOS Integration ('python-pyicloud'):
::    - Note: The official AUR pyicloud package is outdated. An up-to-date
::      recipe is provided in: ~/.conky/pkg/python-pyicloud/
::    - BUNDLED LIBRARIES: python-pyicloud bundles 'python-srp' and
::      'python-tinyhtml' (latest PyPI releases) for modern SRP6a iCloud auth.
::    - IF PACMAN REPORTS A CONFLICT with an existing 'python-srp' or
::      'python-tinyhtml' package, choose YES (Y/I) to allow replacement.
::      python-pyicloud provides both packages and satisfies dependencies.
::
:: 2. Google Find My Device (Android) Integration ('googlefindmytools-git'):
::    - Recipe provided in: ~/.conky/pkg/googlefindmytools-git/
::    - Required AUR dependencies: python-gpsoauth, python-http-ece,
::      python-pyscrypt, python-undetected-chromedriver.
::    - User tokens are safely stored in: ~/.config/googlefindmytools/
::
:: 3. Mouse Events Engine:
::    - Interactive click events require 'conky-mng' (replaces stock 'conky').
::
:: QUICK COMMANDS:
::   conky-nextgen start        # Start all active widgets
::   nextgen-designer           # Launch GTK3 Visual Widget Designer
:: ============================================================================

EOF
}

post_upgrade() {
  post_install
}
