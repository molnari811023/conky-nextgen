post_install() {
  cat << 'EOF'

:: ============================================================================
:: googlefindmytools-git — Google Find My Device (Spot & Nova API)
:: ============================================================================
:: CONFIGURATION & USAGE:
:: - Persistent tokens and secrets are stored in: ~/.config/googlefindmytools/
:: - Run 'googlefindmytools' from terminal for initial Google authentication.
::
:: DEPENDENCIES:
:: - Requires the following AUR packages:
::     python-gpsoauth, python-http-ece, python-pyscrypt,
::     python-undetected-chromedriver.
:: ============================================================================

EOF
}

post_upgrade() {
  post_install
}
