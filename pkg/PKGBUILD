# Maintainer: István Molnár <molnari811023@gmail.com>
# Based on Arch Linux conky (1.22.3) and AUR conky-git PKGBUILDs

pkgname=conky-mng
pkgver=1.24.2.r19.gef154d5
pkgrel=2
pkgdesc='Light-weight system monitor for X, Wayland, and other things, too — with mouse events'
arch=('x86_64')
url='https://github.com/brndnmtthws/conky'
license=(
  'BSD-3-Clause'
  'GPL-3.0-or-later'
)
depends=(
  'cairo'
  'curl' libcurl.so
  'fontconfig'
  'glib2'
  'glibc'
  'hicolor-icon-theme'
  'imlib2'
  'libgcc'
  'libical'
  'libircclient'
  'libmicrohttpd'
  'libpulse' libpulse.so
  'librsvg' librsvg-2.so
  'libstdc++'
  'libx11'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxft'
  'libxinerama'
  'libxml2'
  'libxnvctrl' libXNVCtrl.so
  'lua'
  'mariadb-libs'
  'ncurses' libncursesw.so
  'pango'
  'systemd-libs' libsystemd.so
  'wayland'
  'wireless_tools'
)
makedepends=(
  'catch2'
  'cmake'
  'gettext'
  'git'
  'gperf'
  'pandoc'
  'python-jinja'
  'python-yaml'
  'wayland-protocols'
)

provides=('conky')
conflicts=('conky' 'conky-git')
source=(
  "git+https://github.com/brndnmtthws/conky.git"
  "sigusr1-reload.patch"
)
sha256sums=('SKIP'
            'SKIP')

pkgver() {
  cd conky
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd conky

  # SIGUSR1 reload: skip window+display teardown on X11 during reload
  patch -Np1 -i "${srcdir}/sigusr1-reload.patch"

  # unbundle catch2 to fix build with glibc >= 2.35
  if [ -d tests/catch2 ]; then
    rm -r tests/catch2
    ln -s /usr/include/catch2 tests
  fi
}

build() {
  cd conky

  local _flags=(
    -D CMAKE_BUILD_TYPE=Release
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_INSTALL_DATAROOTDIR=/usr/share
    -D CMAKE_CXX_FLAGS="$CXXFLAGS -ffat-lto-objects"
    -D BUILD_DOCS=ON
    -D BUILD_EXTRAS=ON
    -D BUILD_WLAN=ON
    -D BUILD_XDBE=ON
    -D BUILD_XSHAPE=ON
    -D BUILD_IMLIB2=ON
    -D BUILD_CURL=ON
    -D BUILD_RSS=ON
    -D BUILD_NVIDIA=ON
    -D BUILD_NVIDIA_NVML=ON
    -D BUILD_PULSEAUDIO=ON
    -D BUILD_JOURNAL=ON
    -D BUILD_WAYLAND=ON
    -D BUILD_X11=ON
    -D BUILD_MOUSE_EVENTS=ON
    -D BUILD_LUA_CAIRO=ON
    -D BUILD_LUA_CAIRO_XLIB=ON
    -D BUILD_LUA_IMLIB2=ON
    -D BUILD_LUA_RSVG=ON
    -D BUILD_I18N=ON
    -D BUILD_COLOUR_NAME_MAP=ON
    -D BUILD_ICAL=ON
    -D BUILD_HTTP=ON
    -D BUILD_MYSQL=ON
    -D BUILD_IRC=ON
    -D BUILD_ICONV=ON
    -D BUILD_OPENSOUNDSYS=ON
    -D DOC_PATH=share/doc/$pkgname
  )

  cmake -B build -S . -Wno-dev "${_flags[@]}"
  cmake --build build
}

check() {
  cd conky
  ctest --test-dir build --output-on-failure
}

package() {
  cd conky
  DESTDIR="${pkgdir}" cmake --install build

  install -vDm 644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"

  install -vDm 644 build/extras/vim/syntax/conkyrc.vim -t \
    "${pkgdir}/usr/share/vim/vimfiles/syntax"
  install -vDm 644 extras/vim/ftdetect/conkyrc.vim -t \
    "${pkgdir}/usr/share/vim/vimfiles/ftdetect"
}

# vim: ts=2 sw=2 et:
