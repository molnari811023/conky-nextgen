post_install() {
  cat << 'EOF'

:: ============================================================================
:: python-pyicloud — Bundled Dependencies & Conflict Resolution
:: ============================================================================
:: NOTICE: This package provides the modern (2026.11.x) Apple iCloud / Find My
:: Python suite, replacing the outdated, unmaintained version in the AUR.
::
:: BUNDLED LIBRARIES:
:: To avoid missing or broken dependencies, this package bundles:
::   - python-srp (1.0.22 - latest upstream PyPI)
::   - python-tinyhtml (1.3.0 - latest upstream PyPI)
::
:: RESOLVING DEPENDENCY CONFLICTS:
:: If pacman warns about a conflict with an existing 'python-srp' or
:: 'python-tinyhtml' package:
::   1. You can SAFELY choose YES (Y/I) to replace python-srp / python-tinyhtml.
::      This package explicitly declares:
::        provides: python-srp=1.0.22, python-tinyhtml=1.3.0
::      so any other installed software that depends on python-srp will continue
::      to work seamlessly.
::   2. If a specific system package strictly requires a standalone python-srp
::      package, remove python-pyicloud and install python-srp separately.
:: ============================================================================

EOF
}

post_upgrade() {
  post_install
}
